      <AuxValues>
        <AuxValue name="JavaCodeGenerator_CreateCodeCustom" type="java.lang.String" value="new javax.swing.JLabel() {&#xa;    private java.awt.Image imagem;&#xa;&#xa;    {&#xa;        try {&#xa;            // Caminho da sua imagem dentro do projeto&#xa;            java.net.URL urlLocal = getClass().getResource(&quot;/Imagem/Odontologia Temporaria.png&quot;);&#xa;            if (urlLocal != null) {&#xa;                imagem = new javax.swing.ImageIcon(urlLocal).getImage();&#xa;            } else {&#xa;                // Imagem alternativa caso o Java n&#xe3;o ache a de cima&#xa;                java.net.URL urlWeb = new java.net.URL(&quot;https://images.unsplash.com/photo-1629909613654-28e377c37b09?q=80&amp;w=1200&quot;);&#xa;                imagem = new javax.swing.ImageIcon(urlWeb).getImage();&#xa;            }&#xa;        } catch (Exception e) {&#xa;            System.out.println(&quot;Erro no fundo: &quot; + e.getMessage());&#xa;        }&#xa;    }&#xa;&#xa;    @Override&#xa;    protected void paintComponent(java.awt.Graphics g) {&#xa;        super.paintComponent(g);&#xa;        if (imagem != null) {&#xa;            // Desenha a imagem preenchendo todo o tamanho atual do JLabel&#xa;            g.drawImage(imagem, 0, 0, getWidth(), getHeight(), this);&#xa;        }&#xa;    }&#xa;}"/>
      </AuxValues>
    </Component>
